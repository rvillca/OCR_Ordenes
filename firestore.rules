rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 't18.sitic@gmail.com'
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Order validation helper
    function isValidOrder(data) {
      return data.keys().hasAll([
        'fecha', 'tecnico', 'tipo', 'codigo', 'ot',
        'nombres', 'ordenPhoenix', 'nodo', 'estado',
        'observacion', 'fingerprint', 'createdByUid', 'createdAt'
      ]) &&
      data.fecha is string && data.fecha.size() <= 60 &&
      data.tecnico is string && data.tecnico.size() <= 120 &&
      data.tipo is string && data.tipo.size() <= 120 &&
      data.codigo is string && data.codigo.size() <= 100 &&
      data.ot is string && data.ot.size() <= 100 &&
      data.nombres is string && data.nombres.size() <= 150 &&
      data.ordenPhoenix is string && data.ordenPhoenix.size() <= 100 &&
      data.nodo is string && data.nodo.size() <= 100 &&
      data.estado is string && data.estado.size() <= 100 &&
      data.observacion == '' && // OBSERVACION MUST BE EMPTY STRING
      data.fingerprint is string && data.fingerprint.size() <= 200 &&
      data.createdByUid is string && data.createdByUid == request.auth.uid &&
      data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Orders collection
    match /orders/{orderId} {
      // Authenticated operators and admins can read orders
      allow get, list: if isSignedIn();

      // Creation requires valid id and valid order structure
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        isValidOrder(incoming());

      // Update allowed by owner or admin
      allow update: if isSignedIn() &&
        isValidId(orderId) &&
        (isAdmin() || (existing().createdByUid == request.auth.uid && isValidOrder(incoming())));

      // Delete allowed only by administrator
      allow delete: if isAdmin();
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Administrators collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
